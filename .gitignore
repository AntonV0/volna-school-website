# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/tmp/
/tmp-qa-screens/
/tmp-edge-*/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.codex/
.codex-*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# source migration material for the existing business site
docs/source-screenshots/*
!docs/source-screenshots/.gitkeep
docs/source-copy/*
!docs/source-copy/.gitkeep
docs/site-audit/*
!docs/site-audit/.gitkeep
docs/assets/private/*
!docs/assets/private/.gitkeep
docs/assets/source/*
!docs/assets/source/.gitkeep

# raw originals should be reviewed before becoming public website assets
public/images/original/*
!public/images/original/.gitkeep

# private migration audits and internal planning
/LIVE-WIX-*.md
/docs/meta-*-advertising-strategy.md
/docs/calendar-design-drafts/

# unpublished calendar work and downloadable assets
/public/calendars/
/src/app/(en)/class-one-calendar-2026-2027/

# generated visual experiments that are not approved website assets
/public/images/generated/

# local design exports and unpublished social working files
/output/
/scripts/social/
__pycache__/
*.py[cod]

# social artwork is private-by-default; allow only approved policy previews
/public/images/social/*
!/public/images/social/volna-privacy-policy-social-en-v2.png
!/public/images/social/volna-privacy-policy-social-ru-v2.png
!/public/images/social/volna-refunds-social-en-v2.png
!/public/images/social/volna-refunds-social-ru-v2.png
!/public/images/social/volna-safeguarding-social-en-v2.png
!/public/images/social/volna-safeguarding-social-ru-v2.png

# vercel
.vercel

# typescript
*.tsbuildinfo

.vercel
.env*.local
